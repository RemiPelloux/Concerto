# Concerto runs every model through pi, which reads its own credentials
# from ~/.pi/agent/auth.json (run `pi auth login <provider>` once).
# Nothing below is required. Override only when you need to.

# Path to the pi binary. Default: `pi` on PATH.
CONCERTO_PI_BIN=
# Config file. Default: ./concerto.config.json, then the bundled one.
CONCERTO_CONFIG=
# Pi's agent directory, used to read model prices. Default: ~/.pi/agent
PI_AGENT_DIR=
