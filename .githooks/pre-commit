#!/bin/sh
# >>> smarttest >>>
# Runs only the tests the staged change can affect (https://github.com/RemiPelloux/SmarttyTest).
if [ -x node_modules/.bin/smarttest ]; then
  pnpm exec smarttest run --staged --hook || exit 1
else
  echo "smarttest is not installed: install the project's dependencies first. The affected tests were not run, so the commit stops here (--no-verify skips this check)." >&2
  exit 1
fi
# <<< smarttest <<<
# Pelloux rule 10: check the staged files before every commit.
set -e
python3 .pelloux/pelloux.py audit --staged
pnpm exec tsc --noEmit
