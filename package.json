{
  "name": "concerto",
  "version": "1.1.2",
  "description": "Terminal orchestrator that scores a request into user stories and routes each one to the most efficient model available through pi.",
  "type": "module",
  "bin": {
    "concerto": "dist/cli.js"
  },
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./dist/*"
    },
    "#tests/*": "./tests/*",
    "#scripts/*": "./scripts/*"
  },
  "files": [
    ".pelloux/GUIDELINES.md",
    "concerto.config.json",
    "dist",
    "orca-plugin",
    "prompts",
    "scripts/install.sh",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "tsx --conditions=source src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:affected": "smarttest run --affected",
    "test:explain": "smarttest explain",
    "docs:api": "node --import tsx --conditions=source scripts/api-surface.ts > docs/api-surface.json",
    "docs:reference": "node --import tsx --conditions=source scripts/reference.ts > docs/reference.md",
    "bench:single": "pnpm build && mkdir -p out && node --import tsx --conditions=source scripts/bench-single.ts",
    "perf:budgets": "node --import tsx --conditions=source scripts/perf-budgets.ts dist/cli.js",
    "bench:languages": "node --import tsx --conditions=source scripts/language-bench.ts",
    "perf": "pnpm build && node --import tsx --conditions=source scripts/perf-bench.ts",
    "pelloux": "python3 .pelloux/pelloux.py audit",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm pelloux && pnpm build && pnpm perf:budgets",
    "docs:screens": "node --import tsx --conditions=source scripts/screens/capture.ts"
  },
  "repository": "github:RemiPelloux/Concerto",
  "homepage": "https://remipelloux.github.io/Concerto/",
  "license": "MIT",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "ink": "^6.8.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tkmremi/smarttest": "^1.2.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "0.25.12",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
