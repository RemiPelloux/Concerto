{
  "name": "concerto",
  "version": "0.1.0",
  "description": "Terminal orchestrator that scores a request into user stories and routes each one to the most efficient model available through pi.",
  "type": "module",
  "bin": {
    "concerto": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "audit": "python3 .pelloux/pelloux.py audit",
    "check": "npm run typecheck && npm run lint && npm test && npm run audit",
    "test:affected": "smarttest run --affected",
    "test:explain": "smarttest explain"
  },
  "license": "MIT",
  "repository": "github:RemiPelloux/Concerto",
  "homepage": "https://remipelloux.github.io/Concerto/",
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tkmremi/smarttest": "^1.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
